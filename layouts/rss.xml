{{/*
  RSS feed at /rss.xml (see [outputFormats.RSS] in hugo.toml — baseName "rss",
  so the feed is /rss.xml rather than Hugo's default /index.xml).

  Protect track excluded: /shelf/ pages are noindex, noai, noimageai and never
  appear here (they are also absent from /sitemap.xml), matching the policy stated
  in /llms.txt, /llm.txt, /llms-full.txt and layouts/robots.txt.

  channel title/description come from the site config (site.Title and
  params.description) — do not hardcode them here, so hugo.toml stays the single
  source. Title is already per-language ([languages.tw] / [languages.hk] set it);
  the description is currently project-wide and therefore Chinese in every
  language feed — a per-language params.description in hugo.toml would localize it.
*/}}
{{- $pages := where site.RegularPages "Section" "ne" "shelf" -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = $pages | first $limit }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- if $pages }}
    <lastBuildDate>{{ (index $pages.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "rss" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
