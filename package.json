{
	"name": "hencte.top",
	"private": true,
	"description": "亦幸小阁 — Hugo 站点。Tailwind CSS 与繁体变体在 Hugo 之前生成（pnpm variants / pnpm css）。",
	"scripts": {
		"variants": "node scripts/build_variants.mjs",
		"css": "tailwindcss -i themes/kiss/assets/css/main.css -o assets/css/tailwind.css --cwd .",
		"css:watch": "tailwindcss -i themes/kiss/assets/css/main.css -o assets/css/tailwind.css --cwd . --watch",
		"dev": "hugo server -D",
		"build": "hugo --ignoreCache --cleanDestinationDir --panicOnWarning --printPathWarnings --printI18nWarnings --minify",
		"generate": "pnpm variants && pnpm css",
		"check": "python scripts/verify_urls.py",
		"check:templates": "hugo --ignoreCache --printUnusedTemplates --printPathWarnings --printI18nWarnings",
		"audit:visual": "node scripts/visual_audit.mjs",
		"list": "hugo list all",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.1.11",
		"@tailwindcss/typography": "0.5.16",
		"opencc-js": "1.4.2",
		"playwright-core": "^1.63.0",
		"prettier": "3.6.2",
		"prettier-plugin-go-template": "0.0.15",
		"tailwindcss": "4.1.11"
	}
}
