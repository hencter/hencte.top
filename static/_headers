# Force UTF-8 for plain-text GEO/SEO endpoints.
# Astro prerenders API routes to static files and drops Response headers,
# so charset must be set at the CDN/host layer (Cloudflare / EdgeOne Pages).
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/llm.txt
  Content-Type: text/plain; charset=utf-8

/rss.xml
  Content-Type: application/xml; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
